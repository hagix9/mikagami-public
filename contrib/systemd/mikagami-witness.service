[Unit]
Description=Mikagami Witness
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# `mikagami witness init` must have been run once (see docs/deployment.md).
ExecStart=/usr/local/bin/mikagami witness run --config /etc/mikagami/witness.toml
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
